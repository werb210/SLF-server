PORT=4001
DATABASE_URL=postgresql://user:password@localhost:5432/boreal
# QA host. Production must point at the production SLF instance - see
# migrations/005_slf_retire_stale.sql for what happens when it does not.
SLF_BASE_URL=https://qa-fintech.buildingdigital.com
# SLF_REQUIRE_UPSTREAM_CONFIG_v230 - a real 40-char DRF token was committed
# here and was public for seven months. Rotate it in SLF and never commit
# the replacement; set the real value in Azure app settings only.
SLF_TOKEN=replace-me-with-your-slf-api-token
SLF_PRODUCT_FAMILIES=credit,equipment-financing,factoring-bid,invoice
SYNC_INTERVAL_MINUTES=5
